# Databaze
TRAPLINE_DB_URL=mysql+pymysql://trapline:heslo@127.0.0.1:3306/trapline?charset=utf8mb4

# Ollama (LLM klasifikace inzeratu)
TRAPLINE_OLLAMA_URL=http://172.24.1.111:30068
TRAPLINE_LLM_BULK=qwen3:4b
TRAPLINE_LLM_MAIN=qwen3:14b

# Allegro REST API - apps.developer.allegro.pl
TRAPLINE_ALLEGRO_CLIENT_ID=
TRAPLINE_ALLEGRO_CLIENT_SECRET=

# Notifikace
TRAPLINE_NTFY_URL=https://ntfy.sh/
TRAPLINE_NTFY_TOPIC=

# Vychozi lokalita pro vypocet pickup cost
TRAPLINE_HOME_LAT=50.5606
TRAPLINE_HOME_LON=15.9127

# Crawler etiketa
TRAPLINE_USER_AGENT=Trapline/0.1 (+osobni cenovy monitor)
TRAPLINE_REQUEST_DELAY_S=2.5

# Zabezpeceni GUI jednim sdilenym heslem. Prazdne = otevrene vsem.
APP_PASSWORD=
# Prazdne = podpisovy klic se odvodi z hesla (relace prezije restart).
AUTH_SECRET=
# true jen za HTTPS proxy; po LAN na http musi zustat false.
AUTH_COOKIE_SECURE=false

# Self-update z Gitu pres WEB UI. Bez UPDATE_ENABLED=true se panel v GUI
# nevykresli a /api/system/{check,update} vraci 403.
UPDATE_ENABLED=false
# Prazdne REPO_DIR = odvodi se z umisteni zdrojaku. V Dockeru nastavuje /app
# entrypoint, tam to nepis rucne.
REPO_DIR=
REPO_BRANCH=main

# Syrove snapshoty stazenych feedu (gzip) kvuli zpetnemu preparsovani.
# Prazdne = vypnuto. V Dockeru miri do /app/data/snapshots (volume).
SNAPSHOT_DIR=data/snapshots

# SearXNG pro automaticke hledani zdroju (tlacitko "najit dalsi obchody").
# Prazdne = funkce vypnuta.
TRAPLINE_SEARXNG_URL=

# Obchuzka: interval v hodinach (discovery -> skoring -> reference -> alerty).
# 0 = planovac vypnuty. Notifikace vyzaduji NTFY_TOPIC vyse.
TRAPLINE_WATCH_HOURS=12
